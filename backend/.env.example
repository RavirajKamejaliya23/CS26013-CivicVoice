# CivicVoice Backend Environment Configuration
# Copy this file to .env and replace placeholders with your local credentials.

# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# PostgreSQL Connection String (RECOMMENDED)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/civicvoice

# Alternative Discrete PostgreSQL Parameters (used if DATABASE_URL is not set):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=civicvoice

# JWT Secret Key (generate a strong random secret in production)
JWT_SECRET=civicvoice_jwt_secret_dev_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 (OpenID Connect / Google Identity Services)
# -----------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Used to verify citizen Google ID tokens on backend (audience check).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional: only needed if using authorization code server exchange
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (Nodemailer / SMTP)
# -----------------------------------------------------------------------------
# ₹0 Academic / Development Mode: Leave blank to use ephemeral Ethereal test inbox
# or console-logged preview URLs.
#
# Production / Custom SMTP: Provide credentials for Gmail, Brevo, SendGrid, or AWS SES
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CivicVoice <no-reply@civicvoice.org>

# Frontend URL (Used in email tracking and verification links)
FRONTEND_URL=http://localhost:5173
