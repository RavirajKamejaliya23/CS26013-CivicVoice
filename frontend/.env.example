# CivicVoice Frontend Environment Configuration
# Copy this file to .env or .env.local to configure frontend variables

# Backend API Base URL
VITE_API_URL=/api

# Google OAuth 2.0 Web Client ID (Google Identity Services)
# Must match GOOGLE_CLIENT_ID configured on backend
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
